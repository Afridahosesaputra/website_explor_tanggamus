<%- include('partials/header') %>

<!-- Page Header -->
<div class="page-header">
  <div class="page-title">
    <h2>📊 Dashboard Operasional Toko</h2>
    <p>Ringkasan stok busana, transaksi sewa aktif, dan perputaran kas toko hari ini.</p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/rentals/new" class="btn btn-primary">
      ➕ Buat Transaksi Sewa
    </a>
    <a href="/items/new" class="btn btn-secondary">
      👗 Tambah Busana
    </a>
  </div>
</div>

<!-- Alert Keterlambatan Pengembalian jika ada -->
<% if (stats.overdueCount > 0) { %>
  <div class="alert alert-danger">
    <span>⚠️ <strong>Perhatian:</strong> Terdapat <%= stats.overdueCount %> transaksi sewa yang telah melewati batas tanggal kembali (H+1) dan belum dikembalikan!</span>
    <a href="/rentals?status=DIAMBIL" style="color: var(--danger-text); text-decoration: underline; margin-left: auto; font-weight: 700;">Lihat Transaksi Telat ➔</a>
  </div>
<% } %>

<!-- Stats Grid -->
<div class="stats-grid">
  <!-- Card 1: Total Busana -->
  <div class="stat-card">
    <div class="stat-icon blue">👗</div>
    <div class="stat-info">
      <h4>Total Koleksi</h4>
      <div class="stat-value"><%= stats.totalItems %> Item</div>
      <div class="stat-sub"><%= stats.availableItems %> Siap Disewa • <%= stats.rentedItems %> Sedang Keluar</div>
    </div>
  </div>

  <!-- Card 2: Transaksi Aktif -->
  <div class="stat-card">
    <div class="stat-icon purple">📑</div>
    <div class="stat-info">
      <h4>Sewa Aktif</h4>
      <div class="stat-value"><%= stats.activeRentals %> Order</div>
      <div class="stat-sub">Booking & Sudah Diambil Pelanggan</div>
    </div>
  </div>

  <!-- Card 3: Omset Kas Masuk -->
  <div class="stat-card">
    <div class="stat-icon green">💰</div>
    <div class="stat-info">
      <h4>Kas Masuk (Omset)</h4>
      <div class="stat-value"><%= formatRupiah(stats.totalRevenue) %></div>
      <div class="stat-sub">Pembayaran DP & Pelunasan Kasir</div>
    </div>
  </div>

  <!-- Card 4: Piutang / Sisa Tagihan -->
  <div class="stat-card">
    <div class="stat-icon yellow">⏳</div>
    <div class="stat-info">
      <h4>Sisa Piutang</h4>
      <div class="stat-value"><%= formatRupiah(stats.totalReceivable) %></div>
      <div class="stat-sub">Pelunasan saat Pengambilan / H+1</div>
    </div>
  </div>
</div>

<!-- Card Transaksi Terbaru -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title">
      <span>⏱️ Transaksi Persewaan Terbaru</span>
    </h3>
    <a href="/rentals" class="btn btn-secondary btn-sm">Lihat Semua Sewaan ➔</a>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Kode Transaksi</th>
          <th>Nama Pelanggan</th>
          <th>Busana Disewa</th>
          <th>Jadwal (Ambil / Pakai / Kembali)</th>
          <th>Total Biaya</th>
          <th>Status Bayar</th>
          <th>Status Sewa</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentRentals.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; color: var(--text-dark); padding: 2rem;">
              Belum ada transaksi sewa. Silakan buat transaksi sewa pertama Anda!
            </td>
          </tr>
        <% } else { %>
          <% recentRentals.forEach((r) => { %>
            <tr>
              <td>
                <span class="badge-code"><%= r.transactionCode %></span>
              </td>
              <td>
                <strong><%= r.customer.name %></strong>
                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= r.customer.phone %></div>
              </td>
              <td>
                <% r.rentalItems.forEach((ri) => { %>
                  <div>• <%= ri.item.name %> (<%= ri.item.size %>)</div>
                <% }) %>
              </td>
              <td style="font-size: 0.82rem;">
                <div>Ambil: <strong><%= formatDate(r.pickupDate) %></strong></div>
                <div>Pulang: <strong><%= formatDate(r.returnDate) %></strong></div>
              </td>
              <td>
                <strong><%= formatRupiah(r.finalPrice) %></strong>
                <% if (r.remainingAmount > 0) { %>
                  <div style="font-size: 0.76rem; color: #dc2626; font-weight: 600;">Sisa: <%= formatRupiah(r.remainingAmount) %></div>
                <% } %>
              </td>
              <td>
                <span class="badge <%= r.paymentType === 'LUNAS' ? 'badge-available' : 'badge-booking' %>">
                  <%= r.paymentType %>
                </span>
              </td>
              <td>
                <% if (r.rentalStatus === 'BOOKING') { %>
                  <span class="badge badge-booking">📌 BOOKING</span>
                <% } else if (r.rentalStatus === 'DIAMBIL') { %>
                  <span class="badge badge-diambil">👘 DIAMBIL</span>
                <% } else if (r.rentalStatus === 'SELESAI') { %>
                  <span class="badge badge-selesai">✅ SELESAI</span>
                <% } else { %>
                  <span class="badge badge-batal">❌ BATAL</span>
                <% } %>
              </td>
              <td>
                <a href="/rentals/<%= r.id %>" class="btn btn-secondary btn-sm">
                  🔍 Detail & Nota
                </a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
