<%- include('../partials/header') %>

<div class="page-header">
  <div class="page-title">
    <h2>➕ Tambah Koleksi Busana Baru</h2>
    <p>Masukkan rincian busana tradisional, kebaya, jas formal, atau aksesoris baru.</p>
  </div>
  <div>
    <a href="/items" class="btn btn-secondary">
      ⬅️ Kembali ke Katalog
    </a>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger">
    ⚠️ <%= error %>
  </div>
<% } %>

<div class="card" style="max-width: 800px; margin: 0 auto;">
  <form action="/items" method="POST">
    <div class="form-grid">
      <!-- Kode Busana -->
      <div class="form-group">
        <label class="form-label">Kode Busana <span class="req">*</span></label>
        <input 
          type="text" 
          name="code" 
          class="form-control" 
          placeholder="Contoh: KBY-05 / JAS-04" 
          required 
          value="<%= typeof values !== 'undefined' && values.code ? values.code : '' %>"
          style="text-transform: uppercase;"
        >
        <div class="form-help">Kode unik untuk identifikasi barcode / label fisik busana.</div>
      </div>

      <!-- Nama Busana -->
      <div class="form-group">
        <label class="form-label">Nama Busana <span class="req">*</span></label>
        <input 
          type="text" 
          name="name" 
          class="form-control" 
          placeholder="Contoh: Kebaya Wisuda Brokat Lavender" 
          required
          value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>"
        >
      </div>

      <!-- Kategori -->
      <div class="form-group">
        <label class="form-label">Kategori <span class="req">*</span></label>
        <select name="category" class="form-control" required>
          <option value="Kebaya">Kebaya</option>
          <option value="Jas Formal">Jas Formal</option>
          <option value="Gaun Pengantin">Gaun Pengantin</option>
          <option value="Beskap Adat">Beskap Adat</option>
          <option value="Aksesoris">Aksesoris</option>
        </select>
      </div>

      <!-- Ukuran -->
      <div class="form-group">
        <label class="form-label">Ukuran (Size) <span class="req">*</span></label>
        <select name="size" class="form-control" required>
          <option value="All Size">All Size</option>
          <option value="S">Size S</option>
          <option value="M">Size M</option>
          <option value="L">Size L</option>
          <option value="XL">Size XL</option>
          <option value="XXL">Size XXL</option>
        </select>
      </div>

      <!-- Harga Sewa -->
      <div class="form-group">
        <label class="form-label">Tarif Sewa / Hari (Rp) <span class="req">*</span></label>
        <input 
          type="number" 
          name="rentalPrice" 
          class="form-control" 
          placeholder="150000" 
          min="10000" 
          step="5000" 
          required
          value="<%= typeof values !== 'undefined' && values.rentalPrice ? values.rentalPrice : '' %>"
        >
      </div>

      <!-- Jumlah Stok -->
      <div class="form-group">
        <label class="form-label">Jumlah Stok Fisik</label>
        <input 
          type="number" 
          name="stock" 
          class="form-control" 
          value="1" 
          min="1"
        >
      </div>

      <!-- Deskripsi / Catatan Bahan -->
      <div class="form-group full-width">
        <label class="form-label">Deskripsi & Keterangan Busana</label>
        <textarea 
          name="description" 
          class="form-control" 
          placeholder="Keterangan bahan kain, warna dominan, kelengkapan (misal: rok lilit, furing, bros, dasi)..."
        ><%= typeof values !== 'undefined' && values.description ? values.description : '' %></textarea>
      </div>
    </div>

    <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
      <a href="/items" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">
        💾 Simpan Busana ke Katalog
      </button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
