<%- include('../partials/header') %>

<div class="page-header">
  <div class="page-title">
    <h2>👗 Katalog Koleksi Busana Sewa</h2>
    <p>Kelola data kebaya, jas formal, gaun pengantin, beskap, dan aksesoris toko.</p>
  </div>
  <div>
    <a href="/items/new" class="btn btn-primary">
      ➕ Tambah Koleksi Baru
    </a>
  </div>
</div>

<!-- Notifikasi Sukses / Error -->
<script>
  const urlParams = new URLSearchParams(window.location.search);
  const successMsg = urlParams.get('success');
  const errorMsg = urlParams.get('error');
  if (successMsg) {
    document.write(`<div class="alert alert-success">✅ ${decodeURIComponent(successMsg)}</div>`);
  }
  if (errorMsg) {
    document.write(`<div class="alert alert-danger">⚠️ ${decodeURIComponent(errorMsg)}</div>`);
  }
</script>

<!-- Filter & Search Bar -->
<form action="/items" method="GET" class="filter-bar">
  <input 
    type="text" 
    name="search" 
    class="search-input" 
    placeholder="🔍 Cari nama busana atau kode (contoh: KBY-01)..." 
    value="<%= query.search %>"
  >

  <select name="category" onchange="this.form.submit()">
    <option value="ALL" <%= query.category === 'ALL' ? 'selected' : '' %>>Semua Kategori</option>
    <% categories.forEach((cat) => { %>
      <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
    <% }) %>
  </select>

  <select name="status" onchange="this.form.submit()">
    <option value="ALL" <%= query.status === 'ALL' ? 'selected' : '' %>>Semua Status</option>
    <option value="AVAILABLE" <%= query.status === 'AVAILABLE' ? 'selected' : '' %>>Tersedia (Ready)</option>
    <option value="RENTED" <%= query.status === 'RENTED' ? 'selected' : '' %>>Sedang Disewa</option>
    <option value="LAUNDRY" <%= query.status === 'LAUNDRY' ? 'selected' : '' %>>Dalam Perawatan / Laundry</option>
  </select>

  <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
  <% if (query.search || query.category !== 'ALL' || query.status !== 'ALL') { %>
    <a href="/items" class="btn btn-sm" style="color: var(--text-dark);">Reset</a>
  <% } %>
</form>

<!-- Table of Items -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title">
      <span>Daftar Busana (<%= items.length %> Koleksi Ditemukan)</span>
    </h3>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>No</th>
          <th>Kode</th>
          <th>Nama Busana & Deskripsi</th>
          <th>Kategori</th>
          <th>Ukuran</th>
          <th>Harga Sewa / Hari</th>
          <th>Status Busana</th>
          <th style="text-align: right;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (items.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; color: var(--text-dark); padding: 2.5rem;">
              Tidak ada busana yang sesuai dengan pencarian atau filter Anda.
            </td>
          </tr>
        <% } else { %>
          <% items.forEach((it, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td>
                <span class="badge-code"><%= it.code %></span>
              </td>
              <td>
                <strong style="color: var(--text-main); font-size: 0.95rem;"><%= it.name %></strong>
                <% if (it.description) { %>
                  <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem; max-width: 320px;">
                    <%= it.description %>
                  </div>
                <% } %>
              </td>
              <td><%= it.category %></td>
              <td>
                <span style="background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; padding: 2px 8px; border-radius: 4px; font-weight: 600;">
                  <%= it.size %>
                </span>
              </td>
              <td>
                <strong style="color: #0284c7;"><%= formatRupiah(it.rentalPrice) %></strong>
              </td>
              <td>
                <% if (it.status === 'AVAILABLE') { %>
                  <span class="badge badge-available">● Tersedia</span>
                <% } else if (it.status === 'RENTED') { %>
                  <span class="badge badge-rented">● Sedang Disewa</span>
                <% } else if (it.status === 'LAUNDRY') { %>
                  <span class="badge badge-laundry">● Laundry</span>
                <% } else { %>
                  <span class="badge badge-batal">● <%= it.status %></span>
                <% } %>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <% if (it.status !== 'RENTED') { %>
                  <a href="/items/toggle-status/<%= it.id %>" class="btn btn-secondary btn-sm" title="Ubah status Tersedia / Laundry">
                    🔄 Status
                  </a>
                <% } %>
                <a href="/items/edit/<%= it.id %>" class="btn btn-secondary btn-sm" title="Edit Busana">
                  ✏️ Edit
                </a>
                <a 
                  href="/items/delete/<%= it.id %>" 
                  class="btn btn-danger btn-sm" 
                  onclick="return confirm('Yakin ingin menghapus busana <%= it.name %> (<%= it.code %>)? Data tidak dapat dikembalikan!')"
                  title="Hapus Busana"
                >
                  🗑️
                </a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
