<%- include('../partials/header') %>

<div class="page-header">
  <div class="page-title">
    <h2>👘 Form Transaksi Persewaan Baru ("SEWA AJA")</h2>
    <p>Pilih busana yang tersedia, tentukan jadwal H-1/H/H+1, dan tentukan DP / pelunasan kasir.</p>
  </div>
  <div>
    <a href="/rentals" class="btn btn-secondary">
      ⬅️ Kembali ke Daftar Sewa
    </a>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger">
    ⚠️ <strong>Terjadi Kesalahan:</strong> <%= error %>
  </div>
<% } %>

<form action="/rentals" method="POST">
  <div class="card" style="border-left: 4px solid var(--primary);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">
      <div>
        <span style="font-size: 0.85rem; color: var(--text-muted);">Kode Transaksi:</span>
        <input 
          type="text" 
          name="transactionCode" 
          value="<%= generatedCode %>" 
          style="background: transparent; border: none; font-size: 1.3rem; font-weight: 800; color: #0284c7; font-family: 'JetBrains Mono', monospace; width: 140px;" 
          readonly
        >
      </div>
      <div style="font-size: 0.9rem; color: var(--text-muted);">
        Penjaga Kasir: <strong style="color: var(--text-main);">Seli (Kasir Toko)</strong>
      </div>
    </div>

    <!-- 1. Data Penyewa -->
    <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <span>👤 1. Identitas Pelanggan / Penyewa</span>
    </h3>

    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Nama Lengkap Penyewa <span class="req">*</span></label>
        <input type="text" name="customerName" class="form-control" placeholder="Contoh: Siti Nurhaliza" required>
      </div>

      <div class="form-group">
        <label class="form-label">Nomor WhatsApp / HP Aktif <span class="req">*</span></label>
        <input type="text" name="customerPhone" class="form-control" placeholder="Contoh: 0812-7890-1234" required>
      </div>

      <div class="form-group">
        <label class="form-label">Nomor KTP / SIM Jaminan <span class="req">*</span></label>
        <input type="text" name="idCardNumber" class="form-control" placeholder="Nomor E-KTP / SIM" required>
      </div>

      <div class="form-group">
        <label class="form-label">Jenis Dokumen Fisik Jaminan <span class="req">*</span></label>
        <select name="customerGuarantee" class="form-control" required>
          <option value="E-KTP">E-KTP Asli</option>
          <option value="SIM">SIM Asli (A / C)</option>
          <option value="Kartu Pelajar / Mahasiswa">Kartu Pelajar / Mahasiswa</option>
        </select>
      </div>

      <div class="form-group full-width">
        <label class="form-label">Alamat Tinggal / Domisili</label>
        <input type="text" name="customerAddress" class="form-control" placeholder="Alamat lengkap penyewa di Bandar Lampung / sekitarnya...">
      </div>
    </div>
  </div>

  <!-- 2. Jadwal Sewa (H-1, Hari H, H+1) -->
  <div class="card" style="border-left: 4px solid var(--purple);">
    <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <span>📅 2. Jadwal Persewaan (Siklus H-1, Hari H, H+1)</span>
    </h3>

    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Hari H (Tanggal Pakai / Acara) <span class="req">*</span></label>
        <input type="date" id="eventDate" name="eventDate" class="form-control" value="<%= defaultDates.event %>" required>
        <div class="form-help">Pilih Hari H, tanggal ambil & kembali akan otomatis terhitung.</div>
      </div>

      <div class="form-group">
        <label class="form-label">Tanggal Ambil & Fitting (H-1) <span class="req">*</span></label>
        <input type="date" id="pickupDate" name="pickupDate" class="form-control" value="<%= defaultDates.pickup %>" required>
      </div>

      <div class="form-group">
        <label class="form-label">Tanggal Kembali / Pulang (H+1) <span class="req">*</span></label>
        <input type="date" id="returnDate" name="returnDate" class="form-control" value="<%= defaultDates.return %>" required>
      </div>
    </div>
  </div>

  <!-- 3. Pilih Busana yang Akan Disewa -->
  <div class="card" style="border-left: 4px solid var(--success);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
      <div>
        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.2rem; display: flex; align-items: center; gap: 0.5rem;">
          <span>👗 3. Busana yang Akan Disewa</span>
        </h3>
        <p style="color: var(--text-muted); font-size: 0.85rem;">
          Klik tombol "Cari Barang" untuk membuka modal dan memilih busana yang tersedia (<%= availableItems.length %> Koleksi Ready).
        </p>
      </div>
      <div>
        <button type="button" class="btn btn-primary" onclick="openItemModal()">
          🔍 Cari Barang
        </button>
      </div>
    </div>

    <!-- Container Tabel Barang yang Telah Dipilih -->
    <div id="selectedItemsContainer" style="display: none;">
      <div class="table-responsive">
        <table id="selectedItemsTable">
          <thead>
            <tr>
              <th style="width: 44px;">No</th>
              <th>Kode</th>
              <th>Nama Busana</th>
              <th>Kategori</th>
              <th>Ukuran</th>
              <th>Tarif Sewa</th>
              <th style="text-align: right;">Aksi</th>
            </tr>
          </thead>
          <tbody id="selectedItemsTbody">
            <!-- Diisi secara dinamis oleh JavaScript -->
          </tbody>
        </table>
      </div>
      <div style="margin-top: 0.85rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <span id="selectedCountBadge" class="badge badge-booking">0 Busana Dipilih</span>
        <button type="button" class="btn btn-secondary btn-sm" onclick="openItemModal()">
          ➕ Tambah / Ubah Pilihan Busana
        </button>
      </div>
    </div>

    <!-- Empty State jika belum ada barang dipilih -->
    <div id="emptyItemsBox" class="empty-items-box">
      <div style="font-size: 2.2rem; margin-bottom: 0.5rem;">👘</div>
      <h4 style="font-weight: 700; color: var(--text-main); font-size: 1rem;">Belum Ada Busana yang Dipilih</h4>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem; max-width: 480px; margin-left: auto; margin-right: auto;">
        Pelanggan belum menentukan busana yang akan disewa. Silakan klik tombol di bawah untuk mencari dan memilih dari katalog busana.
      </p>
      <button type="button" class="btn btn-primary btn-sm" onclick="openItemModal()">
        🔍 Cari & Pilih Barang Sekarang
      </button>
    </div>

    <!-- Hidden Inputs untuk mengirimkan data itemIds ke server Express -->
    <div id="hiddenItemInputs"></div>
  </div>

  <!-- 4. Rincian Biaya, Pembayaran & Vermak -->
  <div class="card" style="border-left: 4px solid var(--warning);">
    <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <span>💰 4. Rincian Pembayaran & Catatan Vermak Ukuran</span>
    </h3>

    <div class="form-grid">
      <!-- Catatan Vermak -->
      <div class="form-group full-width">
        <label class="form-label">Catatan Vermak / Fitting Ukuran (Keterangan Khusus)</label>
        <textarea 
          name="fittingNotes" 
          class="form-control" 
          placeholder="Contoh: Jas ini dikecilin pinggang 3 cm, kebaya brokat kancing nomor 2 dikencangkan..."
        ></textarea>
        <div class="form-help">Catatan ini akan dicetak di nota agar penjahit & kasir tidak salah ukuran.</div>
      </div>

      <!-- Tambah Charge -->
      <div class="form-group">
        <label class="form-label">Biaya Tambahan / Charge (Rp)</label>
        <input type="number" id="additionalCharge" name="additionalCharge" class="form-control" value="0" min="0" step="5000">
        <div class="form-help">Biaya sewa aksesoris tambahan, slayer, dasi, atau bando.</div>
      </div>

      <!-- Diskon -->
      <div class="form-group">
        <label class="form-label">Diskon Khusus (Rp)</label>
        <input type="number" id="discount" name="discount" class="form-control" value="0" min="0" step="5000">
        <div class="form-help">Potongan harga promo atau langganan.</div>
      </div>

      <!-- Pembayaran Kasir -->
      <div class="form-group">
        <label class="form-label">Nominal Dibayar (DP Min. Rp 50.000 / Lunas) <span class="req">*</span></label>
        <input type="number" id="paidAmount" name="paidAmount" class="form-control" placeholder="Minimal 50000" min="0" step="5000" required>
        <div class="form-help">Masukkan nominal pembayaran kasir saat ini.</div>
      </div>

      <!-- Metode Pembayaran -->
      <div class="form-group">
        <label class="form-label">Metode Pembayaran <span class="req">*</span></label>
        <select name="paymentMethod" class="form-control" required>
          <option value="TUNAI">Tunai / Cash di Kasir</option>
          <option value="TRANSFER">Transfer Bank (BCA / Mandiri / BSI)</option>
          <option value="QRIS">QRIS Toko</option>
        </select>
      </div>
    </div>

    <!-- Ringkasan Live Calculator Box -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: var(--radius-md); padding: 1.25rem; margin-top: 1.25rem;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: center;">
        <div>
          <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Total Tarif Busana:</div>
          <div id="totalBasePriceDisplay" style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">Rp 0</div>
        </div>
        <div>
          <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Total Akhir Tagihan:</div>
          <div id="finalPriceDisplay" style="font-size: 1.35rem; font-weight: 800; color: #0284c7;">Rp 0</div>
        </div>
        <div>
          <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Sisa Kekurangan:</div>
          <div id="remainingAmountDisplay" style="font-size: 1.2rem; font-weight: 800; color: #dc2626;">Rp 0</div>
        </div>
        <div>
          <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Status Pembayaran:</div>
          <span id="paymentTypeBadge" class="badge badge-booking">DP (Uang Muka)</span>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
    <a href="/rentals" class="btn btn-secondary">Batal</a>
    <button type="submit" class="btn btn-primary" style="padding: 0.85rem 1.75rem; font-size: 1rem;">
      💾 Simpan Transaksi & Cetak Nota
    </button>
  </div>
</form>

<!-- Modal Dialog Pencarian & Pemilihan Barang -->
<div id="itemModal" class="modal-overlay" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-header">
      <div>
        <h3 class="modal-title">
          <span>🔍 Cari & Pilih Busana Sewa</span>
        </h3>
        <p class="modal-subtitle">
          Cari berdasarkan nama, kode (misal: KBY, JAS), atau filter kategori (<%= availableItems.length %> Busana Ready)
        </p>
      </div>
      <button type="button" class="modal-close" onclick="closeItemModal()" title="Tutup Modal">&times;</button>
    </div>

    <div class="modal-body">
      <!-- Search Input & Filter Kategori dalam Modal -->
      <div class="modal-search-bar">
        <input 
          type="text" 
          id="modalSearchInput" 
          class="form-control modal-search-input" 
          placeholder="🔍 Ketik nama busana atau kode barang (contoh: Brokat, Tuxedo, KBY-01)..."
          oninput="filterModalItems()"
        >
        <select id="modalCategoryFilter" class="form-control modal-category-select" onchange="filterModalItems()">
          <option value="ALL">Semua Kategori</option>
          <option value="Kebaya">Kebaya</option>
          <option value="Jas Formal">Jas Formal</option>
          <option value="Gaun Pengantin">Gaun Pengantin</option>
          <option value="Beskap Adat">Beskap Adat</option>
          <option value="Aksesoris">Aksesoris</option>
        </select>
      </div>

      <!-- Tabel Daftar Busana di dalam Modal -->
      <% if (availableItems.length === 0) { %>
        <div class="alert alert-danger" style="margin: 1rem 0;">
          ⚠️ Tidak ada busana yang berstatus "Tersedia" di sistem saat ini.
        </div>
      <% } else { %>
        <div class="table-responsive modal-table-container">
          <table id="modalItemsTable">
            <thead>
              <tr>
                <th style="width: 48px; text-align: center;">Pilih</th>
                <th>Kode</th>
                <th>Nama Busana</th>
                <th>Kategori</th>
                <th>Ukuran</th>
                <th>Tarif Sewa</th>
              </tr>
            </thead>
            <tbody>
              <% availableItems.forEach((it) => { %>
                <tr 
                  class="modal-item-row" 
                  data-id="<%= it.id %>" 
                  data-code="<%= it.code %>" 
                  data-name="<%= it.name.toLowerCase() %>" 
                  data-category="<%= it.category %>" 
                  data-size="<%= it.size %>" 
                  data-price="<%= it.rentalPrice %>"
                >
                  <td style="text-align: center;">
                    <input 
                      type="checkbox" 
                      id="modalCheck_<%= it.id %>"
                      value="<%= it.id %>" 
                      data-id="<%= it.id %>"
                      data-code="<%= it.code %>" 
                      data-name="<%= it.name %>" 
                      data-category="<%= it.category %>" 
                      data-size="<%= it.size %>" 
                      data-price="<%= it.rentalPrice %>" 
                      class="modal-item-checkbox" 
                      style="transform: scale(1.3); cursor: pointer;"
                      onchange="updateModalCounter()"
                    >
                  </td>
                  <td><span class="badge-code"><%= it.code %></span></td>
                  <td>
                    <label for="modalCheck_<%= it.id %>" style="cursor: pointer; font-weight: 700; color: var(--text-main);">
                      <%= it.name %>
                    </label>
                  </td>
                  <td><%= it.category %></td>
                  <td><span class="badge-size"><%= it.size %></span></td>
                  <td><strong style="color: #0284c7;"><%= formatRupiah(it.rentalPrice) %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="modal-footer">
      <div style="font-size: 0.88rem; color: var(--text-muted);">
        <strong id="modalSelectedCounter" style="color: #0284c7; font-size: 1rem;">0</strong> busana dipilih di modal
      </div>
      <div style="display: flex; gap: 0.75rem;">
        <button type="button" class="btn btn-secondary" onclick="closeItemModal()">Batal</button>
        <button type="button" class="btn btn-primary" onclick="confirmModalSelection()">
          ✅ Gunakan Busana Terpilih
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
